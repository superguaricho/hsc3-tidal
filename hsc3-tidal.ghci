:def! boot \_ -> return ":script BootTidal.hs"

:{
let green = "\ESC[1;32m"
    cyan  = "\ESC[1;36m"
    reset' = "\ESC[0m"
    l  = cyan ++ replicate 34 '-' ++ reset'
in do
  putStrLn ""
  putStrLn l
  putStrLn $ cyan ++ "| " ++ green ++ "Type " ++ cyan ++ ":boot" ++ green ++ " to start hsc3-tidal" ++ cyan ++ " |" ++ reset'
  putStrLn l
  putStrLn ""
:}
