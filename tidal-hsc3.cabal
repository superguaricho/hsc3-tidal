cabal-version:      3.0
name:               hsc3-tidal
version:            0.1.0.0
synopsis:
    Send SynthDef's to scsynth via OSC messages to use it from TidalCycles

-- description:
homepage:           http://github.com/superguaricho
license:            BSD-3-Clause
license-file:       LICENSE
author:             Numa Tortolero
maintainer:         numa.tortolero@gmail.com
-- copyright:
category:           Sound
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall
library
    import:           warnings
    exposed-modules:  Sound.Sc3.Tidal,
                      Sound.Sc3.Tidal.Examples
    -- other-modules:

    -- other-extensions:
    build-depends:    base ^>=4.18.3.0,
                      hosc,
                      hsc3,
                      tidal,
                      directory,
                      filepath
    hs-source-dirs:   src
    default-language: Haskell2010
